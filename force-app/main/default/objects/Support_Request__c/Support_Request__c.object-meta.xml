<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Support Request</label>
    <pluralLabel>Support Requests</pluralLabel>
    <description>The single system-of-record for a customer support interaction. Replaces the shared Gmail inbox plus "Case Log.xlsx" spreadsheet. Addresses P1 (no single case record / duplicate work), P2 (priority + SLA routing), P4 (visibility) and P5 (warranty eligibility).</description>
    <nameField>
        <label>Support Request Name</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>true</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableHistory>true</enableHistory>
    <enableFeeds>false</enableFeeds>
    <enableBulkApi>true</enableBulkApi>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <replicateParentAccount>false</replicateParentAccount>
</CustomObject>
