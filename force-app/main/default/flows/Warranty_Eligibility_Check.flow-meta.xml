<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <processType>AutoLaunchedFlow</processType>
    <label>Warranty Eligibility Check</label>
    <description>Auto-launched flow that evaluates whether a purchase is still inside Warranty_Months__c of Order_Date__c as of the request date, and returns an agent-friendly verdict. Called by the Warranty_Eligibility_Check action and the deflection assistant, and used to replace the manual store-admin lookup. Addresses P5 (entitlement/warranty eligibility checked manually). Date logic mirrors WarrantyService.isUnderWarranty and sim/warranty.py, including the inclusive anniversary boundary.</description>
    <interviewLabel>Warranty Eligibility Check-{!$Flow.CurrentDateTime}</interviewLabel>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Outputs</targetReference>
        </connector>
    </start>
    <formulas>
        <name>formIsUnderWarranty</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!varOrderDate}), FALSE, IF(ISBLANK({!varRequestDate}), FALSE, IF({!varWarrantyMonths} &lt;= 0, FALSE, {!varRequestDate} &lt;= ADDMONTHS({!varOrderDate}, {!varWarrantyMonths}))))</expression>
    </formulas>
    <formulas>
        <name>formVerdict</name>
        <dataType>String</dataType>
        <expression>IF({!formIsUnderWarranty}, "This purchase is under warranty - we can start a warranty claim for you.", "This purchase is outside its warranty window. We can still offer our out-of-warranty repair option.")</expression>
    </formulas>
    <assignments>
        <name>Set_Outputs</name>
        <label>Set Outputs</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>varIsUnderWarranty</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formIsUnderWarranty</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varVerdict</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formVerdict</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <variables>
        <name>varOrderDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varWarrantyMonths</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varRequestDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varIsUnderWarranty</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varVerdict</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <status>Active</status>
</Flow>
