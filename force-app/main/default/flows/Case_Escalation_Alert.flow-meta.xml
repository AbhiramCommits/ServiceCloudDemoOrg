<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <processType>AutoLaunchedFlow</processType>
    <label>Case Escalation Alert</label>
    <description>Record-triggered flow with a scheduled path that fires one hour after a Support_Request__c is created. If the request is already past SLA_Due__c with no First_Response_At__c and is not Resolved, it flags the record (Escalated__c = true) so it surfaces on the Support Console and in the backlog-age metric. Addresses P2 (SLA breaches go unnoticed) and P4 (no visibility into breach risk).</description>
    <interviewLabel>Case Escalation Alert-{!$Flow.CurrentDateTime}</interviewLabel>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Support_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterFormula>TEXT({!$Record.Status__c}) != "Resolved"</filterFormula>
        <scheduledPaths>
            <name>Escalation_Check</name>
            <label>Escalation Check</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
            <connector>
                <targetReference>Is_Breached</targetReference>
            </connector>
        </scheduledPaths>
    </start>
    <decisions>
        <name>Is_Breached</name>
        <label>Is SLA Breached Without Response</label>
        <locationX>176</locationX>
        <locationY>258</locationY>
        <defaultConnectorLabel>Not Breached</defaultConnectorLabel>
        <rules>
            <name>Breached</name>
            <label>Breached</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.First_Response_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SLA_Due__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDateTime</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Resolved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_Escalated</targetReference>
            </connector>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Flag_Escalated</name>
        <label>Flag Escalated</label>
        <locationX>176</locationX>
        <locationY>402</locationY>
        <inputReference>$Record</inputReference>
        <inputAssignments>
            <field>Escalated__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority__c</field>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </inputAssignments>
    </recordUpdates>
    <status>Active</status>
</Flow>
